<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:orientation="vertical"
    tools:context=".ResultadosActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarResultados"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="?attr/actionBarTheme"
        android:title="RESULTADOS"/>

<!--    <ScrollView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="0dp"-->
<!--        android:layout_weight="1">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Trofeo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center"
            android:src="@drawable/premio"/>

        <!-- Marcador final -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARCADOR FINAL"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/res_victorias_j1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jugador 1: 0"
            android:gravity="center"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/res_victorias_j2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jugador 2: 0"
            android:gravity="center"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/res_empates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empates: 0"
            android:gravity="center"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/res_rondas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total de rondas: 0"
            android:gravity="center"
            android:padding="4dp"/>

        <!-- Última ronda -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ÚLTIMA RONDA"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jugador 1"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/res_dado1_j1"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cara_1"/>
                    <ImageView
                        android:id="@+id/res_dado2_j1"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cara_1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/res_comb_j1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Combinación: -"
                    android:gravity="center"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="VS"
                android:textStyle="bold"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jugador 2"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/res_dado1_j2"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cara_1"/>
                    <ImageView
                        android:id="@+id/res_dado2_j2"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cara_1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/res_comb_j2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Combinación: -"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/res_ganador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ganador: -"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"/>

    </LinearLayout>
<!--    </ScrollView>-->

    <Button
        android:id="@+id/btn_nuevo_juego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NUEVO JUEGO"/>

</LinearLayout>