<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="?attr/actionBarTheme" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- JUGADOR 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JUGADOR 1"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="4dp"/>

            <EditText
                android:id="@+id/nombre_j1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Inserta tu nombre"
                android:inputType="textPersonName"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/dado1_j1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cara_1"/>
                <ImageView
                    android:id="@+id/dado2_j1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cara_1"/>
            </LinearLayout>

            <TextView
                android:id="@+id/combinacion_j1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMBINACIÓN: -"
                android:gravity="center"
                android:padding="4dp"/>

            <!-- JUGADOR 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JUGADOR 2"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="4dp"/>

            <EditText
                android:id="@+id/nombre_j2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Inserta tu nombre jugador 2"
                android:inputType="textPersonName"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/dado1_j2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cara_1"/>
                <ImageView
                    android:id="@+id/dado2_j2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cara_1"/>
            </LinearLayout>

            <TextView
                android:id="@+id/combinacion_j2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMBINACIÓN: -"
                android:gravity="center"
                android:padding="4dp"/>

            <!-- Ganador de la ronda -->
            <TextView
                android:id="@+id/ganador_ronda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GANADOR: -"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"/>

            <!-- Marcador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/victorias_j1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VIC J1: 0"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/empates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EMPATES: 0"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/victorias_j2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VIC J2: 0"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_lanzar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LANZAR DADOS"/>

    <Button
        android:id="@+id/btn_resultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VER RESULTADOS"/>

    <Button
        android:id="@+id/btn_salir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SALIR"/>

</LinearLayout>